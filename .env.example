# --- Jira (Atlassian Cloud) ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=            # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_JQL=project = ABC ORDER BY updated DESC   # optional

# --- Google Sheets (service account) ---
# Either the full JSON key contents or a path to the key file
GOOGLE_SERVICE_ACCOUNT_JSON=
PRIVATE_SHEET_ID=          # the long id in docs.google.com/spreadsheets/d/<ID>/edit
SHARED_SHEET_ID=           # optional: team-visible sheet
SHEET_TAB_NAME=Jira Tickets
# Optional column overrides (comma separated)
# PRIVATE_COLUMNS=Key,Link,Summary,Status,Assignee,Description
# SHARED_COLUMNS=Key,Link,Type,Summary,Status,Priority,Assignee,Updated,Due Date

# --- BO team sync (bo_sheets.py) ---
JIRA_PROJECT=L1
BO_SHEET_ID=               # "BO Tickets (Auto)" sheet
INPROGRESS_SHEET_ID=       # "In Progress" sheet
BO_FROM=2026-10-01         # sheet 1 only shows tickets created since this date
# BO_TODO_STATUSES=To Do,Clients To Do
# MDB_SOURCE_ID / INSTALLMENT_SOURCE_ID / INSTALLMENT_SOURCE_TAB / PRODUCT_SOURCE_ID override the source sheets
PENDING_SLA_HOURS=48       # Pending Customer Response tickets older than this are flagged OVERDUE
MDB_KEYWORDS=              # words that mark an MDB ticket, comma separated
# IN_PROGRESS_STATUS=In Progress
# OTHER_TEAM_STATUSES=Escalated to MDP,Pending BM,Pending Customer Response,In Progress,Pending Tech (Lucky),Pending On-Boarding,Pending Suez Canal,Pending Tech (Connect),Pending Fraud,Pending Collection
# EXCLUDED_PEOPLE=loay.khaled,nourhan.khaled,mohanad.maher,Abdullah Mubark
SHEET_TIMEZONE=Africa/Cairo
